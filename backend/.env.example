APP_ENV=development
APP_SECRET=replace-with-a-long-local-development-secret
DATABASE_URL=sqlite+pysqlite:///./.angmoo-dev/angmoo.sqlite3
SEED_DEMO_DATA=true
SIGNUP_ENABLED=false
LOGIN_THROTTLE_HMAC_SECRET=
LOGIN_TRUSTED_PROXY_CIDRS=
GOOGLE_AUTH_VERIFY_SOURCE_PER_MINUTE=5
GOOGLE_AUTH_VERIFY_SOURCE_PER_15_MINUTES=20
GOOGLE_AUTH_VERIFY_GLOBAL_PER_MINUTE=60
GOOGLE_AUTH_VERIFY_MAX_IN_FLIGHT=8
GOOGLE_AUTH_VERIFY_LEASE_SECONDS=30
GOOGLE_AUTH_VERIFY_RETENTION_HOURS=24
API_DOCS_ENABLED=true
AGENT_ACTIVITY_ENGINE=langgraph
SERVER_LLM_ENGINE=direct
# Text/embedding backend: gemini (default) or openai_compatible (Ollama, Lemonade,
# LM Studio, llama.cpp). See docs/public/local-llm.md for every OPENAI_COMPAT_* setting.
LLM_BACKEND=gemini
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPAT_CHAT_MODEL=
# OPENAI_COMPAT_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# OPENAI_COMPAT_CONTEXT_TOKENS=32768
RESIDENT_TICK_SCHEDULER_ENABLED=false
POST_IMAGE_JOB_WORKER_ENABLED=false
POLLINATIONS_SERVICE_IMAGE_ENABLED=false
POLLINATIONS_PROFILE_IMAGE_ENABLED=false
# Keep the existing app-secret when reusing stored local credentials.
# 기존 로컬 자격증명을 재사용할 때 app-secret을 교체하지 마세요.
# Hosted OCI KMS is retired; OCI_* fields do not enable a supported provider.
# 이전 hosted OCI KMS는 지원 종료됐으며 OCI_* 설정으로 활성화되지 않습니다.
CREDENTIAL_ENCRYPTION_PROVIDER=local
MEDIA_ROOT=./uploads
MEDIA_URL_PATH=/media

# Canonical embedded relationship projection
GRAPH_PROJECTION_ENABLED=true
GRAPH_PROVIDER=ladybug
LADYBUG_DATABASE_ROOT=./.angmoo-dev/graph
LOCAL_RUNTIME_COMPONENT_MODE=in_process
GRAPH_PROJECTOR_BATCH_SIZE=50
GRAPH_PROJECTOR_POLL_INTERVAL_SECONDS=2
GRAPH_PROJECTOR_WORKER_ID=
GRAPH_PROJECTOR_CONCURRENCY=2
GRAPH_PROJECTOR_COMMAND_TIMEOUT_SECONDS=5
GRAPH_PROJECTOR_SHUTDOWN_DRAIN_SECONDS=20
